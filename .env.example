# Template for the Docker Compose stack (copied to ./.env, which is gitignored).
# docker compose automatically loads ./.env for variable interpolation.
#
# All values below are required by the compose files — there are no fallbacks,
# and Compose fails fast with a clear error if one is missing.
# Generate random values with: openssl rand -base64 48

# --- PostgreSQL (used by the `db` service and the backend's DATABASE_URL) ---
POSTGRES_USER=quizadmin
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_48
POSTGRES_DB=quizdevdb02

# --- Backend ---
# Must be at least 32 characters; the backend refuses to start otherwise.
# CHANGE_ME is deliberately short so copying the template without editing fails validation.
JWT_SECRET=CHANGE_ME
