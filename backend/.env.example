# Template for local (non-Docker) backend development.
# Copy to backend/.env (gitignored) and fill in real values:
#   cp backend/.env.example backend/.env
# Generate secrets with: openssl rand -base64 48

# --- Database ---
DATABASE_URL=postgres://quizadmin:CHANGE_ME@localhost:5432/quizdevdb02

# --- Auth ---
# Must be at least 32 characters; the backend refuses to start otherwise.
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# --- Server ---
PORT=4000
# Comma-separated list of allowed CORS origins (SvelteKit dev server by default).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
